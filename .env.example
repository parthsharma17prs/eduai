# ═══════════════════════════════════════════════════════════════════
# EDU-AI Environment Variables Configuration (Railway & Production)
# ═══════════════════════════════════════════════════════════════════

# ── Server & Frontend ──────────────────────────────────────────────
PORT=5001
NODE_ENV=production
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:5001
DEMO_MODE=true

# ── MongoDB Atlas Database ─────────────────────────────────────────
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/hirespec?retryWrites=true&w=majority

# ── Groq AI Engine (AI Interviews, Coding Hints, Scoring) ──────────
# Get free key → https://console.groq.com
GROQ_API_KEY=gsk_your_groq_api_key_here

# ── Twilio Real-Time Voice Calling ─────────────────────────────────
# Get keys → https://console.twilio.com
TWILIO_ACCOUNT_SID=AC_your_twilio_account_sid_here
TWILIO_AUTH_TOKEN=your_twilio_auth_token_here
TWILIO_PHONE_NUMBER=+10000000000
DESTINATION_PHONE_NUMBER=+918319556016

# ── Ultravox Real-Time Conversational AI Voice ─────────────────────
# Get key → https://app.ultravox.ai
ULTRAVOX_API_KEY=your_ultravox_api_key_here

# ── Pinecone Vector DB (Face Proctoring Verification) ──────────────
PINECONE_FACE_API_KEY=pcsk_your_pinecone_api_key_here
PINECONE_FACE_INDEX_NAME=face-biometrics-index

# ── Authentication & Security ──────────────────────────────────────
JWT_SECRET=hirespec-super-secret-jwt-key-change-in-production-2026
REFRESH_TOKEN_SECRET=hirespec-refresh-secret-key-change-in-production-2026
